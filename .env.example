# ---------------------------------------------------------
# نمونه تنظیمات محیطی — این فایل را به .env کپی کنید
# هیچ مقدار محرمانه‌ای را داخل کد نگذارید.
# ---------------------------------------------------------

NODE_ENV=production
# پورت داخلی برنامه و پورت منتشرشده روی میزبان
PORT=3000
HOST_PORT=3000
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Tehran

# PostgreSQL — در docker compose همین مقادیر برای سرویس db استفاده می‌شود
POSTGRES_DB=uptime
POSTGRES_USER=uptime
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
DATABASE_URL=postgresql://uptime:REPLACE_WITH_RANDOM_DB_PASSWORD@db:5432/uptime
DATABASE_SSL=false
PG_POOL_MAX=20

# امنیت نشست
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false

# ادمین اولیه (در اولین بالا آمدن ساخته می‌شود)
# ADMIN_PASSWORD را حتماً با یک رمز قوی جایگزین کنید؛ خالی بماند ادمینی ساخته نمی‌شود.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SEED_ADMIN_ON_START=true

# کارگر پس‌زمینه
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=50
LOG_LEVEL=info

# ---------- کانال‌های هشدار (هر کدام را می‌خواهید فعال کنید) ----------
# ایمیل / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# تلگرام
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# وب‌هوک عمومی
WEBHOOK_URL=
WEBHOOK_SECRET=
